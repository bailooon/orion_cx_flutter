# Copie para .env e ajuste. O arquivo .env não é versionado.
# Todos os valores têm padrão seguro para desenvolvimento; nada aqui é obrigatório.

# Segredo de assinatura do JWT.
# Obrigatório quando ORION_ENV=production: a aplicação recusa iniciar com o padrão.
ORION_JWT_SECRET=orion-dev-secret-change-me

# Chave da API Claude. Sem ela, o motor de NLU roda o classificador por regras
# e os dois fluxos de demonstração continuam funcionando integralmente.
ANTHROPIC_API_KEY=

# Modelo usado na classificação de intenção.
ORION_NLU_MODEL=claude-opus-5

# Confiança mínima para o atendimento seguir automático.
# Abaixo deste valor, o caso é encaminhado para um atendente humano.
ORION_CONFIDENCE_THRESHOLD=0.70

# URLs que o bundle Flutter usa para falar com o gateway (build do frontend).
ORION_API_URL=http://localhost:8000
ORION_WS_URL=ws://localhost:8000/ws
